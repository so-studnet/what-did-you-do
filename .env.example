# Supabase の接続情報（docs/setup.md を参照）。未設定ならブラウザ内保存だけで動く。
# どちらもブラウザに載る公開用の値。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- アプリを閉じていても通知する（Web Push）。docs/setup.md の 7 を参照 ----
# 公開鍵（ブラウザに載る）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# ここから下はサーバー専用の秘密の値。NEXT_PUBLIC_ を付けないこと。
VAPID_PRIVATE_KEY=
# 連絡先（mailto:自分のメールアドレス）
VAPID_SUBJECT=
# Supabase の Secret key（sb_secret_...）。通知を送るサーバー処理だけが使う
SUPABASE_SECRET_KEY=
# 定期実行からの呼び出しを確かめる合言葉（長いランダムな文字列）
CRON_SECRET=
